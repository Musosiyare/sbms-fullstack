# SBMS connects to the SAME MySQL database as the school-system backend.
# Copy the DB_* values exactly from the main system's .env — this is what
# makes it "shared DB": one database, two separate backends.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_reporting
DB_USER=root
DB_PASSWORD=your_mysql_root_password

# SBMS runs as its own server on its own port.
PORT=4100

# Deliberately a DIFFERENT secret from the main system's JWT_SECRET. A person
# logs into SBMS separately from the main app (same email/password, since
# both read the same `users` table) — this keeps the two sessions fully
# independent, so logging out of one never affects the other.
SBMS_JWT_SECRET=change_me_to_a_different_long_random_string
SBMS_JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5174

# --- MTN Rwanda SMS (guardian notifications on conduct-mark deductions) ---
# Register an app at https://developers.mtn.com, subscribe it to an SMS
# product (SMS v2 / SMS v3) available for Rwanda, and fill these in from
# that app's page. See src/services/mtnSmsService.js for details on what
# each one is used for and what to double check against your app's docs.
MTN_SMS_TOKEN_URL=https://api.mtn.com/v1/oauth/access_token/accesstoken?grant_type=client_credentials
MTN_SMS_SEND_URL=https://api.mtn.com/v3/sms/messages/sms/outbound
MTN_SMS_CONSUMER_KEY=your_mtn_consumer_key
MTN_SMS_CONSUMER_SECRET=your_mtn_consumer_secret
# Only needed if your MTN product requires an APIM subscription key header.
MTN_SMS_SUBSCRIPTION_KEY=
# Shown as the SMS sender/short code, if your MTN product supports one.
MTN_SMS_SENDER_ID=SBMS
