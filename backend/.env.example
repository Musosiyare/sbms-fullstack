# SBMS connects to the SAME MySQL database as the school-system backend.
# Copy the DB_* values exactly from the main system's .env — this is what
# makes it "shared DB": one database, two separate backends.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_reporting
DB_USER=root
DB_PASSWORD=your_mysql_root_password

# SBMS runs as its own server on its own port.
PORT=4100

# Deliberately a DIFFERENT secret from the main system's JWT_SECRET. A person
# logs into SBMS separately from the main app (same email/password, since
# both read the same `users` table) — this keeps the two sessions fully
# independent, so logging out of one never affects the other.
SBMS_JWT_SECRET=change_me_to_a_different_long_random_string
SBMS_JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5174
